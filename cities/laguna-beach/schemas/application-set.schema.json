{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossbeam.example/skills/laguna-permit-preparer/application-set.schema.json",
  "title": "Laguna permit application set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "address_fact_id", "current_stage", "records", "confirmed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "confirmed", "blocked"]},
    "address_fact_id": {"const": "site.address"},
    "current_stage": {"enum": ["exploring", "planning_preparation", "planning_submitted", "planning_approved_not_effective", "planning_approved_effective", "building_preparation", "building_correction", "permit_issuance"]},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "note": {"type": ["string", "null"]}
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_id", "label", "module", "deep_link"],
      "properties": {
        "type_id": {"enum": [114, 182, 183, 186, 187, 188, 214]},
        "label": {"type": "string", "minLength": 1},
        "module": {"enum": ["PLANS", "PERMITS"]},
        "deep_link": {"type": "string", "format": "uri"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane", "scope_label", "scope_description_fact_id", "rationale", "forms", "prerequisites", "channel", "portal", "valuation_fact_id", "attachments", "status", "blocked_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "lane": {"enum": ["planning", "building"]},
        "scope_label": {"type": "string", "minLength": 1},
        "scope_description_fact_id": {"type": "string", "minLength": 1},
        "rationale": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
        "forms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "prerequisites": {"type": "array", "items": {"type": "string"}, "description": "Fact IDs for sourced Boolean prerequisite determinations; all must be true before portal readiness."},
        "channel": {"enum": ["online", "appointment", "counter", "unverified"]},
        "portal": {"anyOf": [{"$ref": "#/$defs/portal"}, {"type": "null"}]},
        "valuation_fact_id": {"type": ["string", "null"]},
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "path", "required"],
            "properties": {
              "category": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            }
          }
        },
        "status": {"enum": ["proposed", "confirmed", "blocked", "prerequisite_pending"]},
        "blocked_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
