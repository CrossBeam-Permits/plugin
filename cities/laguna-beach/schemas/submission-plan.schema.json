{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossbeam.example/skills/laguna-permit-preparer/submission-plan.schema.json",
  "title": "Laguna EnerGov submission plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "records"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transaction"}}
  },
  "$defs": {
    "factValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "value"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "value": {}
      }
    },
    "portalField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_name", "fact_id", "value"],
      "properties": {
        "field_name": {"type": "string", "minLength": 1},
        "fact_id": {"type": "string", "minLength": 1},
        "value": {}
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity_fact_id"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "identity_fact_id": {"type": "string", "minLength": 1}
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "files"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature", "final_submit", "payment"],
      "properties": {
        "signature": {"const": "user_personal_entry_required"},
        "final_submit": {"const": "fresh_explicit_approval_required"},
        "payment": {"const": "separate_explicit_approval_required"}
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "portal_type_id", "module", "label", "deep_link", "idempotency_key", "address", "basic_info", "contacts", "custom_fields", "uploads", "checkpoints", "expected_confirmation", "post_submit_next_action", "status"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "portal_type_id": {"enum": [114, 182, 183, 186, 187, 188, 214]},
        "module": {"enum": ["PLANS", "PERMITS"]},
        "label": {"type": "string", "minLength": 1},
        "deep_link": {"type": "string", "format": "uri"},
        "idempotency_key": {"type": "string", "minLength": 16},
        "address": {"$ref": "#/$defs/factValue"},
        "basic_info": {"type": "array", "items": {"$ref": "#/$defs/factValue"}},
        "contacts": {"type": "array", "items": {"$ref": "#/$defs/contact"}},
        "custom_fields": {"type": "array", "items": {"$ref": "#/$defs/portalField"}},
        "uploads": {"type": "array", "items": {"$ref": "#/$defs/upload"}},
        "checkpoints": {"$ref": "#/$defs/checkpoint"},
        "expected_confirmation": {"type": "string", "minLength": 1},
        "post_submit_next_action": {"type": "string", "minLength": 1},
        "status": {"enum": ["portal_ready", "saved_draft", "blocked"]},
        "blocked_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
